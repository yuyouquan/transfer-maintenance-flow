<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40" xmlns:dt="uuid:C2F41010-65B3-11d1-A29F-00AA00C14882"><DocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><Title>转维材料配置导入模板</Title><Subject>配置中心转维材料导入模板，包含填写示例和字段解释</Subject><LastAuthor>shswyuyouquan</LastAuthor><Created>2026-05-29T17:45:00Z</Created><LastSaved>2026-05-29T17:49:52Z</LastSaved></DocumentProperties><CustomDocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><ICV dt:dt="string">DAD60A975185E106D160196A0106C0E2_42</ICV><KSOProductBuildVer dt:dt="string">2052-12.1.25205.25205</KSOProductBuildVer><CalculationRule dt:dt="float">0</CalculationRule></CustomDocumentProperties><ExcelWorkbook xmlns="urn:schemas-microsoft-com:office:excel"><WindowWidth>28800</WindowWidth><WindowHeight>11460</WindowHeight><ProtectStructure>False</ProtectStructure><ProtectWindows>False</ProtectWindows></ExcelWorkbook><Styles><Style ss:ID="Default" ss:Name="Normal"/><Style ss:ID="s49"/><Style ss:ID="s50"><Alignment ss:WrapText="1"/></Style><Style ss:ID="s51"><Alignment ss:WrapText="1"/><Interior ss:Color="#FBD2FB" ss:Pattern="Solid"/></Style></Styles><Worksheet ss:Name="导入数据"><Table ss:ExpandedColumnCount="6" ss:ExpandedRowCount="3" x:FullColumns="1" x:FullRows="1" ss:DefaultColumnWidth="54" ss:DefaultRowHeight="17.6"><Column ss:Index="1" ss:StyleID="s50" ss:AutoFitWidth="0" ss:Width="168.3" ss:Span="1"/><Column ss:Index="3" ss:StyleID="s50" ss:AutoFitWidth="0" ss:Width="210"/><Column ss:StyleID="s50" ss:AutoFitWidth="0" ss:Width="199.95"/><Column ss:StyleID="s50" ss:AutoFitWidth="0" ss:Width="197.5"/><Column ss:StyleID="s50" ss:AutoFitWidth="0" ss:Width="168.3"/><Row ss:Height="36"><Cell ss:StyleID="s51"><Data ss:Type="String">类型</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">评审要素</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">责任角色(SPM/TPM/底软/系统/影像)</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">资料录入-责任人(在研SPM/在研TPM/在研底软/在研系统/在研影像)</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">人工审核-责任人(维护SPM/维护TPM/维护底软/维护系统/维护影像)</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">智能检查规则</Data></Cell></Row><Row ss:Height="36"><Cell ss:StyleID="s50"><Data ss:Type="String">检查项</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">Jenkins编译界面所有参数需更新到准确</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">SPM</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">在研SPM</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">维护SPM</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">确认给出的文本里包含Jenkins链接即可</Data></Cell></Row><Row ss:Height="18"><Cell ss:StyleID="s50"><Data ss:Type="String">交接资料</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">测试用例库交接</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">测试</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">在研TPM</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">维护TPM</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">检查文本包含测试用例库链接</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Header/><Footer/></PageSetup><Selected/><TopRowVisible>1</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><PageBreakZoom>100</PageBreakZoom><Panes><Pane><Number>3</Number><ActiveRow>13</ActiveRow><ActiveCol>2</ActiveCol><RangeSelection>R14C3</RangeSelection></Pane></Panes><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet><Worksheet ss:Name="字段说明"><Table ss:ExpandedColumnCount="4" ss:ExpandedRowCount="7" x:FullColumns="1" x:FullRows="1" ss:DefaultColumnWidth="54" ss:DefaultRowHeight="17.6"><Row><Cell><Data ss:Type="String">字段说明</Data></Cell><Cell><Data ss:Type="String">是否必填</Data></Cell><Cell><Data ss:Type="String">解释</Data></Cell><Cell><Data ss:Type="String">填写示例</Data></Cell></Row><Row><Cell><Data ss:Type="String">类型</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">区分转维材料类型，建议只填写“检查项”或“交接资料”。</Data></Cell><Cell><Data ss:Type="String">检查项</Data></Cell></Row><Row><Cell><Data ss:Type="String">评审要素</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">需要在转维流程中完成录入和审核的材料名称。</Data></Cell><Cell><Data ss:Type="String">版本分支管理策略确认</Data></Cell></Row><Row><Cell><Data ss:Type="String">责任角色</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">负责完成该材料的并行角色，可填写 SPM、测试、底软、系统、影像。</Data></Cell><Cell><Data ss:Type="String">系统</Data></Cell></Row><Row><Cell><Data ss:Type="String">资料录入-责任人</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">研发阶段负责录入该材料的角色或岗位名称。</Data></Cell><Cell><Data ss:Type="String">在研系统集成开发代表</Data></Cell></Row><Row><Cell><Data ss:Type="String">人工审核-责任人</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">维护阶段负责审核该材料的角色或岗位名称。</Data></Cell><Cell><Data ss:Type="String">维护系统集成开发代表</Data></Cell></Row><Row><Cell><Data ss:Type="String">智能检查规则</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">AI 自动检查时使用的判断口径，建议写清楚需要识别的链接、文档、截图或关键内容。</Data></Cell><Cell><Data ss:Type="String">检查文本包含系统集成编译配置</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Header/><Footer/></PageSetup><TopRowVisible>0</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><PageBreakZoom>100</PageBreakZoom><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet><Worksheet ss:Name="导入说明"><Table ss:ExpandedColumnCount="1" ss:ExpandedRowCount="5" x:FullColumns="1" x:FullRows="1" ss:DefaultColumnWidth="54" ss:DefaultRowHeight="17.6"><Row><Cell><Data ss:Type="String">导入说明</Data></Cell></Row><Row><Cell><Data ss:Type="String">1. 请保留“导入数据”工作表首行表头，按列填写正式数据。</Data></Cell></Row><Row><Cell><Data ss:Type="String">2. “导入数据”工作表中的两行数据为填写示例，正式导入前可删除或替换。</Data></Cell></Row><Row><Cell><Data ss:Type="String">3. 导入会覆盖当前模板数据，并生成新的模板版本。</Data></Cell></Row><Row><Cell><Data ss:Type="String">4. 若责任角色填写不在允许范围内，后续初始化转维申请时将无法正确匹配角色责任人。</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Header/><Footer/></PageSetup><TopRowVisible>0</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><PageBreakZoom>100</PageBreakZoom><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet></Workbook>