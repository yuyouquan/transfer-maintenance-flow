<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet" xmlns:html="http://www.w3.org/TR/REC-html40" xmlns:dt="uuid:C2F41010-65B3-11d1-A29F-00AA00C14882"><DocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><Title>评审要素配置导入模板</Title><Subject>配置中心评审要素导入模板，包含填写示例和字段解释</Subject><LastAuthor>shswyuyouquan</LastAuthor><Created>2026-05-29T17:48:05Z</Created><LastSaved>2026-05-29T17:50:05Z</LastSaved></DocumentProperties><CustomDocumentProperties xmlns="urn:schemas-microsoft-com:office:office"><ICV dt:dt="string">56C4F43FC442D6ACF060196A153CA8B0_42</ICV><KSOProductBuildVer dt:dt="string">2052-12.1.25205.25205</KSOProductBuildVer><CalculationRule dt:dt="float">0</CalculationRule></CustomDocumentProperties><ExcelWorkbook xmlns="urn:schemas-microsoft-com:office:excel"><WindowWidth>28800</WindowWidth><WindowHeight>11460</WindowHeight><ProtectStructure>False</ProtectStructure><ProtectWindows>False</ProtectWindows></ExcelWorkbook><Styles><Style ss:ID="Default" ss:Name="Normal"/><Style ss:ID="s49"/><Style ss:ID="s50"><Alignment ss:WrapText="1"/></Style><Style ss:ID="s51"><Alignment ss:WrapText="1"/><Interior ss:Color="#FBD2FB" ss:Pattern="Solid"/></Style></Styles><Worksheet ss:Name="导入数据"><Table ss:ExpandedColumnCount="7" ss:ExpandedRowCount="3" x:FullColumns="1" x:FullRows="1" ss:StyleID="s50" ss:DefaultColumnWidth="54" ss:DefaultRowHeight="17.6"><Column ss:Index="1" ss:StyleID="s50" ss:AutoFitWidth="0" ss:Width="105.8" ss:Span="2"/><Column ss:Index="4" ss:StyleID="s50" ss:AutoFitWidth="0" ss:Width="227.45"/><Column ss:StyleID="s50" ss:AutoFitWidth="0" ss:Width="202.45" ss:Span="1"/><Column ss:Index="7" ss:StyleID="s50" ss:AutoFitWidth="0" ss:Width="135"/><Row ss:Height="63"><Cell ss:StyleID="s51"><Data ss:Type="String">标准</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">说明</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">备注</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">责任角色(SPM/TPM/底软/系统/影像)</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">资料录入-责任人(在研SPM/在研TPM/在研底软/在研系统/在研影像)</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">人工审核-责任人(维护SPM/维护TPM/维护底软/维护系统/维护影像)</Data></Cell><Cell ss:StyleID="s51"><Data ss:Type="String">智能检查规则</Data></Cell></Row><Row ss:Height="53"><Cell ss:StyleID="s50"><Data ss:Type="String">文档归档</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">确认项目关键文档已归档到指定服务器</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">包括项目计划、SPD、产品价值表等</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">SPM</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">在研SPM</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">维护SPM</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">检查文本中是否包含归档服务器链接，并验证文档可访问</Data></Cell></Row><Row ss:Height="53"><Cell ss:StyleID="s50"><Data ss:Type="String">驱动完整性</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">确认所有关键驱动模块已完整交接</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">包括源码、文档、调试工具</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">底软</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">在研底软集成开发代表</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">维护底软集成开发代表</Data></Cell><Cell ss:StyleID="s50"><Data ss:Type="String">检查文本是否包含驱动源码仓库链接和技术文档</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Header/><Footer/></PageSetup><Selected/><TopRowVisible>0</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><PageBreakZoom>100</PageBreakZoom><Panes><Pane><Number>3</Number><ActiveRow>2</ActiveRow><ActiveCol>3</ActiveCol><RangeSelection>R3C4</RangeSelection></Pane></Panes><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet><Worksheet ss:Name="字段说明"><Table ss:ExpandedColumnCount="4" ss:ExpandedRowCount="8" x:FullColumns="1" x:FullRows="1" ss:DefaultColumnWidth="54" ss:DefaultRowHeight="17.6"><Row><Cell><Data ss:Type="String">字段说明</Data></Cell><Cell><Data ss:Type="String">是否必填</Data></Cell><Cell><Data ss:Type="String">解释</Data></Cell><Cell><Data ss:Type="String">填写示例</Data></Cell></Row><Row><Cell><Data ss:Type="String">标准</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">评审要素所属标准或分类，用于列表展示和搜索。</Data></Cell><Cell><Data ss:Type="String">系统集成</Data></Cell></Row><Row><Cell><Data ss:Type="String">说明</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">该评审要素需要确认的具体内容。</Data></Cell><Cell><Data ss:Type="String">确认系统集成编译配置已完整记录</Data></Cell></Row><Row><Cell><Data ss:Type="String">备注</Data></Cell><Cell><Data ss:Type="String">否</Data></Cell><Cell><Data ss:Type="String">补充说明、范围限定或需要提供的材料提示。</Data></Cell><Cell><Data ss:Type="String">包括编译环境、参数配置</Data></Cell></Row><Row><Cell><Data ss:Type="String">责任角色</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">负责完成该评审要素的并行角色，可填写 SPM、测试、底软、系统、影像。</Data></Cell><Cell><Data ss:Type="String">底软</Data></Cell></Row><Row><Cell><Data ss:Type="String">资料录入-责任人</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">研发阶段负责录入该评审要素的角色或岗位名称。</Data></Cell><Cell><Data ss:Type="String">在研底软集成开发代表</Data></Cell></Row><Row><Cell><Data ss:Type="String">人工审核-责任人</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">维护阶段负责审核该评审要素的角色或岗位名称。</Data></Cell><Cell><Data ss:Type="String">维护底软集成开发代表</Data></Cell></Row><Row><Cell><Data ss:Type="String">智能检查规则</Data></Cell><Cell><Data ss:Type="String">是</Data></Cell><Cell><Data ss:Type="String">AI 自动检查时使用的判断口径，建议写清楚需要识别的链接、文档、截图或关键内容。</Data></Cell><Cell><Data ss:Type="String">检查文本中是否包含系统编译配置文档</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Header/><Footer/></PageSetup><TopRowVisible>0</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><PageBreakZoom>100</PageBreakZoom><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet><Worksheet ss:Name="导入说明"><Table ss:ExpandedColumnCount="1" ss:ExpandedRowCount="5" x:FullColumns="1" x:FullRows="1" ss:DefaultColumnWidth="54" ss:DefaultRowHeight="17.6"><Row><Cell><Data ss:Type="String">导入说明</Data></Cell></Row><Row><Cell><Data ss:Type="String">1. 请保留“导入数据”工作表首行表头，按列填写正式数据。</Data></Cell></Row><Row><Cell><Data ss:Type="String">2. “导入数据”工作表中的两行数据为填写示例，正式导入前可删除或替换。</Data></Cell></Row><Row><Cell><Data ss:Type="String">3. 导入会覆盖当前模板数据，并生成新的模板版本。</Data></Cell></Row><Row><Cell><Data ss:Type="String">4. 备注可为空；其它必填字段建议不要留空，以免后续转维申请初始化信息不完整。</Data></Cell></Row></Table><WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><PageSetup><Header/><Footer/></PageSetup><TopRowVisible>0</TopRowVisible><LeftColumnVisible>0</LeftColumnVisible><PageBreakZoom>100</PageBreakZoom><ProtectObjects>False</ProtectObjects><ProtectScenarios>False</ProtectScenarios></WorksheetOptions></Worksheet></Workbook>